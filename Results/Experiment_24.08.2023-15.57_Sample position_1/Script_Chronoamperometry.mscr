e
var c
var p
var t
set_pgstat_chan 0
set_pgstat_mode 3
set_max_bandwidth 40
set_range ba 2100u
set_autoranging ba 2100n 2100u
set_e 500m
cell_on
store_var t 0 eb
meas_loop_ca p c 100m 100m 20100m
    pck_start
    pck_add t
    pck_add p
    pck_add c
    pck_end
    add_var t 100m
endloop
on_finished:
cell_off

