from opentrons import protocol_api
from opentrons.types import Location, Point

metadata = {'apiLevel': '2.6'}


def run(protocol: protocol_api.ProtocolContext):
	# Labware
	labware_1 = protocol.load_labware('opentrons_6_tuberack_falcon_50ml_conical', 1)
	labware_3 = protocol.load_labware('opentrons_10_tuberack_falcon_4x50ml_6x15ml_conical', 3)
	labware_10 = protocol.load_labware('opentrons_96_tiprack_1000ul', 10)
	labware_11 = protocol.load_labware('opentrons_96_tiprack_20ul', 11)
	left_pipette = protocol.load_instrument(instrument_name='p1000_single_gen2', mount='left')
	right_pipette = protocol.load_instrument(instrument_name='p20_single_gen2', mount='right')

	# Protocol
	right_pipette.pick_up_tip(labware_11.wells()[12])
	right_pipette.aspirate(20.0, location=labware_1.wells()[0].bottom(z=58.5025552169527))
	right_pipette.dispense(20.0, location=labware_3.wells()[9].bottom(z=58.5025552169527))
	right_pipette.aspirate(20.0, location=labware_1.wells()[0].bottom(z=58.470074616321696))
	right_pipette.dispense(20.0, location=labware_3.wells()[9].bottom(z=58.470074616321696))
	right_pipette.drop_tip()
	right_pipette.pick_up_tip(labware_11.wells()[13])
	right_pipette.aspirate(20.0, location=labware_1.wells()[2].bottom(z=58.648717919792176))
	right_pipette.dispense(20.0, location=labware_3.wells()[9].bottom(z=58.648717919792176))
	right_pipette.aspirate(20.0, location=labware_1.wells()[2].bottom(z=58.61623731916116))
	right_pipette.dispense(20.0, location=labware_3.wells()[9].bottom(z=58.61623731916116))
	right_pipette.drop_tip()

