	# Protocol
	right_pipette.pick_up_tip(labware_11.wells()[16])
	right_pipette.aspirate(17.241041409263133, location=labware_1.wells()[0].bottom(z=58.35651197322338))
	right_pipette.dispense(17.241041409263133, location=labware_3.wells()[9].bottom(z=58.35651197322338))
