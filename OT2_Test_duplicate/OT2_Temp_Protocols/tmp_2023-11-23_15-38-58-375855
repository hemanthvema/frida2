	right_pipette.dispense(17.241041409263133, location=labware_3.wells()[9].bottom(z=58.328512004199524))
	right_pipette.drop_tip()
	right_pipette.pick_up_tip(labware_11.wells()[17])
	right_pipette.aspirate(14.448510172852897, location=labware_1.wells()[2].bottom(z=57.97234350748482))
	right_pipette.dispense(14.448510172852897, location=labware_3.wells()[9].bottom(z=57.97234350748482))
	right_pipette.aspirate(14.448510172852897, location=labware_1.wells()[2].bottom(z=57.94887869305296))
	right_pipette.dispense(14.448510172852897, location=labware_3.wells()[9].bottom(z=57.94887869305296))
	right_pipette.aspirate(14.448510172852897, location=labware_1.wells()[2].bottom(z=57.925413878621086))
	right_pipette.dispense(14.448510172852897, location=labware_3.wells()[9].bottom(z=57.925413878621086))
